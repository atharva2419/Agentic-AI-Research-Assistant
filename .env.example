# Copy this file to .env and fill in your keys. Never commit .env.

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Tavily search API key (https://app.tavily.com)
TAVILY_API_KEY=

# Database (default: SQLite file data/research.db in the project). Any SQLAlchemy URL works,
# e.g. postgresql+psycopg://user:pass@host/db (would need the psycopg driver).
# DATABASE_URL=sqlite:///./data/research.db

# Optional: force every step onto one model (e.g. claude-haiku-5-5) for cheap smoke tests.
# Leave empty to use the per-step models from blueprints/research.yaml.
LLM_MODEL_OVERRIDE=

LOG_LEVEL=INFO

# true = built-in fake AI and fake search for any topic: no keys, no cost (UI work, demo fallback)
OFFLINE_MODE=false
