# Copy this file to .env and fill in your keys. Never commit .env.

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Tavily search API key (https://app.tavily.com)
TAVILY_API_KEY=

# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://...)
DATABASE_URL=sqlite:///./data/research.db

# Optional: force every step onto one model (e.g. claude-haiku-5-5) for cheap smoke tests.
# Leave empty to use the per-step models from blueprints/research.yaml.
LLM_MODEL_OVERRIDE=

LOG_LEVEL=INFO
